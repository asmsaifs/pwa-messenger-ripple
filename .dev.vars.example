# Copy to .dev.vars (gitignored) for local `wrangler dev`.
# M0 has no secrets yet — populated as later milestones add them (see docs/08-DEPLOYMENT.md §3).

# M3 — Better Auth (docs/05 §10). Any non-empty string works for local dev;
# rotating it invalidates every session.
BETTER_AUTH_SECRET=dev-only-change-me

# M3 — Turnstile (docs/05 §8). Optional: leave unset locally and the signup
# captcha check is skipped. Set to a real secret (and wire the matching
# VITE_TURNSTILE_SITE_KEY client-side) to exercise it end to end.
# TURNSTILE_SECRET=

# M9 — R2 presigning (docs/08 §3). Any non-empty string works for local dev
# (see .dev.vars's note); use a real "Object Read & Write" R2 API token to
# exercise a real upload against the local Miniflare bucket.
R2_ACCESS_KEY_ID=dev-only-change-me
R2_SECRET_ACCESS_KEY=dev-only-change-me

# M12 — Web Push VAPID keypair (docs/05 §8/§10, docs/08 §3). Unlike the other
# placeholders above, this pair MUST be a real P-256 keypair in the exact
# format src/server/lib/vapid.ts expects (raw uncompressed point / raw `d`,
# both base64url) — it's fed straight into WebCrypto, which errors on
# anything else. Generate a fresh one with `node scripts/generate-vapid-keys.mjs`
# (or `npx web-push generate-vapid-keys`, same format) and set the matching
# public half as `VITE_VAPID_PUBLIC_KEY` in `.env.local` (see that file's
# example). Never commit a real keypair; rotating it invalidates every
# existing subscription (2-key rollover if forced in production).
VAPID_PUBLIC_KEY=dev-only-run-scripts/generate-vapid-keys.mjs
VAPID_PRIVATE_KEY=dev-only-run-scripts/generate-vapid-keys.mjs
