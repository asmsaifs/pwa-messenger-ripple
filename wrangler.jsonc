{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ripple",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // DO / R2 / KV / Queues / Email bindings are added in the milestones that
  // introduce them (see docs/09-ROADMAP.md) so wrangler dev never points at
  // infrastructure the code doesn't use yet.
  "vars": { "APP_ENV": "local", "APP_BASE_URL": "http://localhost:8787" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ripple-local",
      "database_id": "b4e5e256-befd-4a36-a480-30b090373f44",
      "migrations_dir": "./migrations",
    },
  ],

  // Better Auth session secondary storage (M3, docs/02 §6).
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "72298198f66845388ed5f2a3c7fce356",
    },
  ],
}
