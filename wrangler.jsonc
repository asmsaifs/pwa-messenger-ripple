{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ripple",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // DO / R2 / KV / Queues / Email bindings are added in the milestones that
  // introduce them (see docs/09-ROADMAP.md) so wrangler dev never points at
  // infrastructure the code doesn't use yet.
  "vars": { "APP_ENV": "local", "APP_BASE_URL": "http://localhost:8787" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ripple-local",
      "database_id": "b4e5e256-befd-4a36-a480-30b090373f44",
      "migrations_dir": "./migrations",
    },
  ],

  // Better Auth session secondary storage (M3, docs/02 §6).
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "72298198f66845388ed5f2a3c7fce356",
    },
  ],

  // RateLimiterDO (M5, docs/02 §3) — abuse controls (docs/05 §8): invite
  // sends (10/day), invite resends (1/24h), later reused for turn-credential
  // and other per-user limits.
  // ConversationDO (M6, docs/01 §6) — SQLite messages/receipts/typing, one
  // instance per conversation, addressed the same `idFromName` way.
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" },
      { "name": "CONVERSATION", "class_name": "ConversationDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiterDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ConversationDO"] },
  ],

  // Cloudflare Email Sending (M5) — invite emails. No `send_email` binding
  // here yet: the pinned wrangler/Miniflare version in this repo (3.114.17)
  // doesn't support it (adding it made every local worker fail to boot with
  // "internal error" — reproduced, not assumed). src/server/lib/mail.ts's
  // `sendInviteEmail` already checks for `env.EMAIL` and falls back to a
  // console-log "local mail catcher" when it's absent, so invites still work
  // end-to-end locally. Add `"send_email": [{ "name": "EMAIL" }]` here once
  // wrangler is upgraded (`npm install --save-dev wrangler@4`) and the domain
  // is onboarded via `wrangler email sending enable <domain>` (docs/08).
}
