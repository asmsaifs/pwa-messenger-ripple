{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ripple",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // DO / KV / Queues / Email bindings are added in the milestones that
  // introduce them (see docs/09-ROADMAP.md) so wrangler dev never points at
  // infrastructure the code doesn't use yet.
  //
  // R2_ACCOUNT_ID is not secret (it's the account id half of the S3-compatible
  // endpoint host, docs/08 §3) so it lives here rather than `.dev.vars`; the
  // access key pair is the actual credential and stays in `.dev.vars`/`wrangler
  // secret put`.
  "vars": {
    "APP_ENV": "local",
    "APP_BASE_URL": "http://localhost:8787",
    "R2_ACCOUNT_ID": "dev-local-account",
    "MEDIA_BUCKET_NAME": "ripple-media-local",
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ripple-local",
      "database_id": "b4e5e256-befd-4a36-a480-30b090373f44",
      "migrations_dir": "./migrations",
    },
  ],

  // Better Auth session secondary storage (M3, docs/02 §6).
  // ICE_KV (M13, docs/02 §6): per-user cached TURN credentials, `ice:{userId}`.
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "72298198f66845388ed5f2a3c7fce356",
    },
    {
      "binding": "ICE_KV",
      "id": "9b6a2f6e4c4a4f6e9b6a2f6e4c4a4f6e",
    },
  ],

  // RateLimiterDO (M5, docs/02 §3) — abuse controls (docs/05 §8): invite
  // sends (10/day), invite resends (1/24h), later reused for turn-credential
  // and other per-user limits.
  // ConversationDO (M6, docs/01 §6) — SQLite messages/receipts/typing, one
  // instance per conversation, addressed the same `idFromName` way.
  // UserDO (M7, docs/01 §6) — personal event bus/presence/unread, one
  // instance per user.
  // CallDO (M13, docs/01 §6) — signaling relay + call state machine, one
  // instance per call.
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" },
      { "name": "CONVERSATION", "class_name": "ConversationDO" },
      { "name": "USER", "class_name": "UserDO" },
      { "name": "CALL", "class_name": "CallDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiterDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ConversationDO"] },
    { "tag": "v3", "new_sqlite_classes": ["UserDO"] },
    { "tag": "v4", "new_sqlite_classes": ["CallDO"] },
  ],


  // Attachment bytes (M9, docs/02 §4). "local" here really is Miniflare's
  // in-memory simulator (docs/08 §1's table), not a real R2 bucket — good
  // enough for `env.MEDIA.put/get/head/delete` (what `/complete` and the
  // orphan-sweep cron use) but it does not speak the S3-compatible API that
  // presigned URLs are signed against, so a presigned PUT/GET only resolves
  // against a real bucket (staging/prod, or `wrangler r2 bucket create
  // ripple-media-local` + real R2 creds swapped into `.dev.vars` if you need
  // to exercise an actual browser upload locally).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ripple-media-local" }],

  // Analytics Engine (M13/M15, docs/07 §8) — `call_metrics` data points.
  // env.ts already typed `ANALYTICS: AnalyticsEngineDataset` and CallDO wrote
  // to it since M13, but the actual binding was missing here — a gap this
  // milestone's "metrics dashboard" item closes; the write itself has always
  // been best-effort/try-caught, so this only makes it actually land instead
  // of silently no-op'ing on `env.ANALYTICS` being undefined.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "call_metrics" }],

  // `push-queue` (M12, docs/03 §4, docs/08 §2). Producer: ConversationDO +
  // friend routes (fan-out to offline members). Consumer:
  // src/server/push/consumer.ts, wired in src/server/index.ts's `queue()`
  // export. `push-dlq` needs no separate consumer binding — a queue only
  // needs one when a Worker actively drains it, and nothing here does; it
  // exists purely as the `dead_letter_queue` landing spot for messages that
  // exhausted `max_retries`, inspectable via `wrangler queues consumer` /
  // the dashboard.
  // `export-queue` (M15, docs/03 "Data": `POST /api/account/export`).
  // Producer: src/server/lib/export-queue.ts. Consumer:
  // src/server/export/consumer.ts, wired in src/server/index.ts's `queue()`
  // export — mirrors `push-queue`'s shape exactly, including the
  // no-consumer-binding-needed DLQ.
  "queues": {
    "producers": [
      { "binding": "PUSH_QUEUE", "queue": "push-queue" },
      { "binding": "EXPORT_QUEUE", "queue": "export-queue" },
    ],
    "consumers": [
      {
        "queue": "push-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "push-dlq",
      },
      {
        "queue": "export-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "export-dlq",
      },
    ],
  },

  // Orphan sweeps (docs/03 §5): `*/10` deletes R2 object + row for
  // attachments stuck `pending` >24h (abandoned uploads — the client never
  // called `/complete`). `*/5` (M13) marks `ringing` calls with no live DO
  // alarm as `missed` (belt-and-braces — see src/server/lib/call-sweep.ts).
  // `0 4 * * *` (M15, docs/05 §9, docs/03 §5) purges `account_deletions` rows
  // whose 30-day grace period has passed.
  "triggers": { "crons": ["*/10 * * * *", "*/5 * * * *", "0 4 * * *"] },

  // Invite emails go through Brevo's transactional API (docs/08 §6), not
  // Cloudflare Email Sending — no wrangler binding needed, just the
  // `BREVO_API_KEY` secret per env (`wrangler secret put BREVO_API_KEY
  // --env <env>`). Absent locally, `sendInviteEmail` falls back to a
  // console-log "local mail catcher".

  // Staging (docs/08 §1, §5): no custom domain yet, so it serves off the
  // account's workers.dev subdomain instead of `staging.ripple.app`.
  // Distinct D1/R2/KV/queues from local and prod so no environment can read
  // or write another's data.
  "env": {
    "staging": {
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" },
          { "name": "CONVERSATION", "class_name": "ConversationDO" },
          { "name": "USER", "class_name": "UserDO" },
          { "name": "CALL", "class_name": "CallDO" },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RateLimiterDO"] },
        { "tag": "v2", "new_sqlite_classes": ["ConversationDO"] },
        { "tag": "v3", "new_sqlite_classes": ["UserDO"] },
        { "tag": "v4", "new_sqlite_classes": ["CallDO"] },
      ],
      "triggers": { "crons": ["*/10 * * * *", "*/5 * * * *", "0 4 * * *"] },
      "vars": {
        "APP_ENV": "staging",
        "APP_BASE_URL": "https://ripple-staging.asmsaifs.workers.dev",
        "R2_ACCOUNT_ID": "21408569f7e7d8f7c81231eb197fae15",
        "MEDIA_BUCKET_NAME": "ripple-media-staging",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ripple-staging",
          "database_id": "d080c55a-126f-4e18-859d-5c4e591c8adf",
          "migrations_dir": "./migrations",
        },
      ],
      "kv_namespaces": [
        { "binding": "SESSIONS_KV", "id": "a222903bd3d9492aaaf223d9328d3db6" },
        { "binding": "ICE_KV", "id": "c8754a24e2cf4189a1376f3ac288edb3" },
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ripple-media-staging" }],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "call_metrics_staging" }],
      "queues": {
        "producers": [
          { "binding": "PUSH_QUEUE", "queue": "ripple-staging-push-queue" },
          { "binding": "EXPORT_QUEUE", "queue": "ripple-staging-export-queue" },
        ],
        "consumers": [
          {
            "queue": "ripple-staging-push-queue",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "ripple-staging-push-dlq",
          },
          {
            "queue": "ripple-staging-export-queue",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "ripple-staging-export-dlq",
          },
        ],
      },
    },
  },
}
